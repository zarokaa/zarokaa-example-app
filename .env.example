# ---------------------------------------------------------------------------
# Copy to .env and fill in. `.env` is gitignored and must stay that way: the
# client secret below can act as your app against every customer who installed
# it.
# ---------------------------------------------------------------------------

# Where this app is reachable. In development that is the tunnel URL, NOT
# localhost — Zarokaa redirects a customer's browser here and posts webhooks
# here, so it has to be a public HTTPS address. See the README.
APP_BASE_URL=https://your-tunnel.example.com

# From the developer portal: Apps → your app → Credentials.
ZAROKAA_CLIENT_ID=pgc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZAROKAA_CLIENT_SECRET=pgs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Zarokaa hub. Its directory lists every Zarokaa installation allowed to
# install your app; install tokens from any other issuer are refused.
# Leave blank for single-installation dev mode (only ZAROKAA_API_BASE is trusted).
ZAROKAA_HUB_URL=

# The Zarokaa deployment you are building against in dev mode.
ZAROKAA_API_BASE=https://demo.zarokaa.example.com/api/ext/v1

# Shown once when you register a webhook endpoint. Used to verify that a
# webhook really came from Zarokaa. If you have not registered one yet, leave
# it blank — the app starts fine and simply refuses deliveries.
ZAROKAA_WEBHOOK_SECRET=

# Optional. Defaults to 3000.
PORT=3000

# Optional. Serve HTTPS directly (both or neither), e.g. with a self-signed cert for local review checks.
# Most deployments terminate TLS in front of the app and leave these blank.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Optional. frame-ancestors sent on every page (the review check fetches the app URL without ?host=).
# Defaults to the origin of ZAROKAA_API_BASE. /embed narrows it to the host actually framing it.
APP_FRAME_ANCESTORS=
